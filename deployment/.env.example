# Copy to .env for local fixture use. Keep credential material in external files.
YUHENG_FIXTURE_POSTGRES_PASSWORD_FILE=/path/to/fixture-postgres-password
DEMO_SERVICE_VERSION=1.0.0-demo

# Required only for the model overlay. Supply local schema/bindings and provider-version files.
YUHENG_MODEL_FIXTURE_CONFIG_DIR=/path/to/local/model-config
YUHENG_MODEL_FIXTURE_PROVIDER_VERSION_DIR=/path/to/local/model-provider-versions
