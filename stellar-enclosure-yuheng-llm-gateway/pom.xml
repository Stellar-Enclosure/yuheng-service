<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>top.egon</groupId>
        <artifactId>stellar-enclosure-yuheng</artifactId>
        <version>0.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>stellar-enclosure-yuheng-llm-gateway</artifactId>
    <packaging>jar</packaging>
    <name>stellar-enclosure-yuheng-llm-gateway</name>
    <description>Standalone LLM engine role for Stellar Enclosure Yuheng.</description>

    <properties>
        <mapstruct.version>1.6.3</mapstruct.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-yuheng-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-yuheng-core</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-yuheng-runtime-core</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-mybatis-plus-sharding-jdbc-ext-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-yuheng-starter-openapi-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianquan-shoubing-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianquan-jianshen-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-trace-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-common-id-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>stellar-enclosure-yuheng-llm-gateway</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring.boot.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <classifier>exec</classifier>
                    <mainClass>top.egon.cola.component.yuheng.llm.bootstrap.LlmGatewayApplication</mainClass>
                    <layout>JAR</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>permission-producer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-compile</id>
                                <configuration>
                                    <annotationProcessorPaths combine.children="append">
                                        <path>
                                            <groupId>top.egon</groupId>
                                            <artifactId>stellar-enclosure-tianquan-jianshen-processor</artifactId>
                                            <version>${project.version}</version>
                                        </path>
                                    </annotationProcessorPaths>
                                    <compilerArgs>
                                        <arg>-Apac.business=xingyuan</arg>
                                        <arg>-Apac.application=yuheng</arg>
                                        <arg>-Apac.producer=yuheng-llm-java</arg>
                                        <arg>-Apac.module=${project.artifactId}</arg>
                                        <arg>-Apac.expectedModules=stellar-enclosure-yuheng-llm-gateway</arg>
                                        <arg>-Apac.ownedKeyPrefixes=yuheng.llm.</arg>
                                        <arg>-Apac.managedPackages=top.egon.cola.component.yuheng.llm.permission</arg>
                                        <arg>-Apac.repository=yuheng-service</arg>
                                        <arg>-Apac.commit=${permission.commit}</arg>
                                        <arg>-Apac.buildId=${permission.buildId}</arg>
                                        <arg>-Apac.version=${project.version}</arg>
                                        <arg>-Apac.metadataOnlyTypes=top.egon.cola.component.yuheng.llm.permission.NativeProtocolPermissionMetadata</arg>
                                    </compilerArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <permission.producer.enabled>true</permission.producer.enabled>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>top.egon</groupId>
                                <artifactId>stellar-enclosure-tianquan-jianshen-manifest-cli</artifactId>
                                <version>${project.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>aggregate-permission-manifest</id>
                                <phase>prepare-package</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>top.egon.cola.platform.tianquan.jianshen.manifestcli.PermissionManifestBuildCli</mainClass>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <addOutputToClasspath>false</addOutputToClasspath>
                                    <addResourcesToClasspath>false</addResourcesToClasspath>
                                    <executableDependency>
                                        <groupId>top.egon</groupId>
                                        <artifactId>stellar-enclosure-tianquan-jianshen-manifest-cli</artifactId>
                                    </executableDependency>
                                    <arguments>
                                        <argument>--module</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.outputDirectory}/META-INF/permissions/manifest-v1.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-permission-artifact</id>
                                <phase>verify</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>top.egon.cola.platform.tianquan.jianshen.manifestcli.PermissionManifestBuildCli</mainClass>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <addOutputToClasspath>false</addOutputToClasspath>
                                    <addResourcesToClasspath>false</addResourcesToClasspath>
                                    <executableDependency>
                                        <groupId>top.egon</groupId>
                                        <artifactId>stellar-enclosure-tianquan-jianshen-manifest-cli</artifactId>
                                    </executableDependency>
                                    <arguments>
                                        <argument>--artifact</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}-exec.jar</argument>
                                        <argument>--output</argument>
                                        <argument>${project.build.directory}/permissions/artifact-evidence.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
